# General application settings
APP_ENV=development
LOG_LEVEL=INFO

# Snowflake connection
# Use the orgname-account_name account identifier without snowflakecomputing.com.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# Use Snowflake password authentication for a standard trial or native user.
SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_PASSWORD=
# Use externalbrowser only when browser-based SSO is configured for the account.

SNOWFLAKE_ROLE=ISP_LOADER
SNOWFLAKE_WAREHOUSE=INDUSTRIAL_SERVICE_WH
SNOWFLAKE_DATABASE=INDUSTRIAL_SERVICE_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_QUERY_TAG=industrial-service-data-ingestion

# dbt uses the transformation role while the ingestion pipeline keeps ISP_LOADER.
DBT_SNOWFLAKE_ROLE=ISP_TRANSFORMER

# Optional SAP sandbox connection
SAP_API_BASE_URL=
SAP_API_KEY=
