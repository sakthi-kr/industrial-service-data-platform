-- Create these measures one at a time in Power BI Desktop.
-- Use Home > New measure and paste the expression after the equals sign.

Cases =
SUM('MART_SERVICE_OPERATIONS'[CASE_COUNT])

Open Cases =
SUM('MART_SERVICE_OPERATIONS'[OPEN_CASE_COUNT])

Critical Open Cases =
SUM('MART_SERVICE_OPERATIONS'[CRITICAL_OPEN_CASE_COUNT])

Resolved Cases =
SUM('MART_SERVICE_OPERATIONS'[RESOLVED_CASE_COUNT])

Response SLA % =
DIVIDE(
    SUM('MART_SERVICE_OPERATIONS'[RESPONSE_SLA_MET_COUNT]),
    SUM('MART_SERVICE_OPERATIONS'[RESPONSE_SLA_ELIGIBLE_COUNT])
)

Resolution SLA % =
DIVIDE(
    SUM('MART_SERVICE_OPERATIONS'[RESOLUTION_SLA_MET_COUNT]),
    SUM('MART_SERVICE_OPERATIONS'[RESOLUTION_SLA_ELIGIBLE_COUNT])
)

Mean Resolution Hours =
DIVIDE(
    SUMX(
        'MART_SERVICE_OPERATIONS',
        'MART_SERVICE_OPERATIONS'[MEAN_RESOLUTION_HOURS]
            * 'MART_SERVICE_OPERATIONS'[RESOLVED_CASE_COUNT]
    ),
    SUM('MART_SERVICE_OPERATIONS'[RESOLVED_CASE_COUNT])
)

Service Cost EUR =
SUM('MART_SERVICE_OPERATIONS'[SERVICE_COST_EUR])

Downtime Hours =
SUM('MART_SERVICE_OPERATIONS'[DOWNTIME_HOURS])

Asset Count =
COUNTROWS('MART_ASSET_RELIABILITY')

High-Risk Assets =
CALCULATE(
    [Asset Count],
    'MART_ASSET_RELIABILITY'[IS_HIGH_RISK] = TRUE()
)

Asset Service Cost EUR =
SUM('MART_ASSET_RELIABILITY'[SERVICE_COST_EUR])

Asset Downtime Hours =
SUM('MART_ASSET_RELIABILITY'[DOWNTIME_HOURS])

Critical Alerts =
SUM('MART_ASSET_RELIABILITY'[CRITICAL_ALERT_COUNT])

Customer Count =
COUNTROWS('MART_CUSTOMER_PERFORMANCE')

KPI Median Resolution Hours =
MAX('MART_KPI_SUMMARY'[MEDIAN_RESOLUTION_HOURS])

KPI First-Time-Fix % =
MAX('MART_KPI_SUMMARY'[FIRST_TIME_FIX_RATE])

KPI Repeat Failure % =
MAX('MART_KPI_SUMMARY'[REPEAT_FAILURE_RATE])
