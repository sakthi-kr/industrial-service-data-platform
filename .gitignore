# Python bytecode and build outputs
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, type-checking, and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local environment variables and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.crt

# Generated and source-system data
data/raw/*
!data/raw/.gitkeep
data/generated/*
!data/generated/.gitkeep

# dbt-generated files and local profiles
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/profiles.yml
profiles.yml

# Power BI binary and temporary files
*.pbix
*.pbix.tmp

# Logs
logs/
*.log

# IDE settings
.idea/
.vscode/

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini
